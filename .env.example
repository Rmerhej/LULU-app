# Copiez ce fichier en ".env" (ignoré par Git) et remplissez vos propres valeurs.
# Il est lu par docker compose et par Spring Boot.

# Base de données
DB_PASSWORD=changez-moi
DB_ROOT_PASSWORD=changez-moi-aussi

# Connexion à l'application (8 caractères minimum)
APP_USERNAME=lulu
APP_PASSWORD=changez-ce-mot-de-passe

# Offres d'emploi : https://developer.adzuna.com (gratuit)
ADZUNA_APP_ID=votre-app-id
ADZUNA_APP_KEY=votre-app-key

# IA : https://aistudio.google.com/apikey (gratuit)
GEMINI_API_KEY=votre-cle-gemini
# Facultatif : changer de modèle sans toucher au code
# GEMINI_MODEL=gemini-3.1-flash-lite
